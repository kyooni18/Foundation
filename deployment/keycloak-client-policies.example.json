{
  "profiles": {
    "profiles": [
      {
        "name": "prime-radiant-cimd",
        "description": "Published ChatGPT and Claude identities only",
        "executors": [
          {
            "executor": "client-id-metadata-document",
            "configuration": {
              "cimd-allow-http-scheme": false,
              "cimd-allow-permitted-domains": ["chatgpt.com", "claude.ai", "persistent.oaistatic.com"],
              "cimd-restrict-same-domain": false,
              "cimd-required-properties": ["client_id", "redirect_uris", "grant_types", "response_types"],
              "only-allow-confidential-client": false,
              "accept-public-client-with-confidential-client-only-grant": true,
              "cimd-resource-indicator-allow-list": ["https://memory.example.com/mcp"]
            }
          }
        ]
      }
    ]
  },
  "policies": {
    "policies": [
      {
        "name": "prime-radiant-cimd",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": ["https"],
              "client-id-uri-allow-permitted-domains": ["chatgpt.com", "claude.ai"]
            }
          }
        ],
        "profiles": ["prime-radiant-cimd"]
      }
    ]
  }
}
