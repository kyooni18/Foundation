# Foundation configuration
# Copy to .env, set credentials, then run: docker compose up --build.
# Optional settings are commented out; uncomment only what you want to override.
# Examples show application defaults unless noted. Never commit real secrets.

# --- Docker Compose ----------------------------------------------------------
# Change before starting PostgreSQL. URL-encode special characters if used in a URL.
POSTGRES_PASSWORD=change-me
# Compose uses this for LLM_PROVIDER (application default outside Compose: none).
CLOUD_LLM_PROVIDER=openai

# --- Database ----------------------------------------------------------------
# Compose builds DATABASE_URL from POSTGRES_PASSWORD and uses the db service host.
# The URL below is the default for running the application outside Docker.
# DATABASE_URL=postgresql://foundation:foundation@127.0.0.1:5432/foundation
# DATABASE_POOL_SIZE=10

# --- HTTP server and authentication -------------------------------------------
# Compose overrides HOST to 0.0.0.0, PORT to 8787, and MCP_PATH to /mcp.
# HOST=127.0.0.1
# PORT=8787
# MCP_PATH=/mcp
# REST_PATH=/api/v1
# Optional API authentication; leave empty for local-only use.
FOUNDATION_API_KEY=
# Public URL advertised to clients; defaults to http://${HOST}:${PORT}.
# Set to your externally reachable URL when using a reverse proxy.
# FOUNDATION_PUBLIC_BASE_URL=http://localhost:8787

# --- OAuth -------------------------------------------------------------------
# Automatically enabled when an approval secret or FOUNDATION_API_KEY is set.
# Uncomment to explicitly enable or disable (true or false).
# OAUTH_ENABLED=false
# Defaults to FOUNDATION_API_KEY when omitted or empty.
# OAUTH_APPROVAL_SECRET=
# Access lifetime: minimum 300 seconds; refresh lifetime: minimum 3600 seconds.
# OAUTH_ACCESS_TTL_SECONDS=3600
# OAUTH_REFRESH_TTL_SECONDS=2592000

# --- MCP capabilities --------------------------------------------------------
# File tools: off | read | write. Enable only for trusted clients.
# FOUNDATION_MCP_FILE_ACCESS=off
# Enable admin getConfig/setConfig on both stdio and HTTP MCP.
FOUNDATION_MCP_ADMIN=false
# Enable Notion tools (requires the Notion CLI).
# FOUNDATION_MCP_NOTION=false

# --- Project, time zone, and Notion --------------------------------------------
# Default project scope; empty means no default project.
# FOUNDATION_PROJECT=
# Defaults to the system time zone, falling back to UTC.
# FOUNDATION_TIME_ZONE=UTC
# NOTION_CLI=ntn
# NOTION_DATA_SOURCE_ID=

# --- AI providers ------------------------------------------------------------
# LLM: none | apple | openai. Compose overrides this with CLOUD_LLM_PROVIDER.
# LLM_PROVIDER=none
# Embeddings: none | openai | gemini. Compose defaults to gemini, app to none.
# Set the matching OPENAI_API_KEY or GEMINI_API_KEY below; none disables embeddings.
EMBEDDING_PROVIDER=gemini
# Fixed storage dimension; only 3072 is supported (also fixed in Compose).
# EMBEDDING_DIMENSIONS=3072
# Request timeout, clamped to 1000–120000 milliseconds.
# AI_TIMEOUT_MS=30000

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-6-luna
# Interpretation defaults to OPENAI_LLM_MODEL, then EXTRACTION_MODEL, then
# gpt-5.6-luna. Leave commented to follow your selected LLM model.
# OPENAI_INTERPRETATION_MODEL=gpt-5.6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Flex processing for OpenAI chat/Responses (not embeddings or transcription).
OPENAI_FLEX_ENABLED=true

# --- Gemini embeddings -------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Apple Foundation Models -------------------------------------------------
# Defaults to this repository's compiled native bridge (absolute path at runtime).
# APPLE_FOUNDATION_BRIDGE=./native/apple-foundation-model/.build/release/foundation-apple-bridge

# --- Compatibility aliases ---------------------------------------------------
# Prefer the provider-specific settings above for new configurations.
# AI_PROVIDER is used only when LLM_PROVIDER is unset (none | apple | openai).
# AI_PROVIDER=none
# EXTRACTION_MODEL is a fallback for OpenAI LLM and interpretation models.
# EXTRACTION_MODEL=gpt-5.6-luna
# EMBEDDING_MODEL is a fallback for the selected provider's embedding model.
# EMBEDDING_MODEL=text-embedding-3-large
# Compose explicitly sets provider-specific model defaults, so these model
# aliases do not override those defaults when running with Docker Compose.
