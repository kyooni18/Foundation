# Explicit degraded default: lexical retrieval; no paid services.
EMBEDDING_MODE=off
MEMORY_LIMIT=1g
# Set local to enable CPU Nemotron. Existing verified files are mounted read-only.
# MODEL_DIR=/absolute/path/to/nemotron-3-embed-1b
# Both required to enable optional OpenRouter extraction (also provision key + budget).
EXTRACTION_MODEL=
EXTRACTION_REVIEWER=
# Empty preserves the application's audited production default.
EXTRACTION_PROMPT_VERSION=
