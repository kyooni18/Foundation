POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://foundation:change-me@127.0.0.1:55432/foundation
DATABASE_POOL_SIZE=10
FOUNDATION_DOCKER_MACHINE=docker
FOUNDATION_DOCKER_SSH_TARGET=dockerd-machine
FOUNDATION_DB_TUNNEL_PORT=55432
FOUNDATION_DB_VM_PORT=5432
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp
FOUNDATION_MCP_FILE_ACCESS=off
FOUNDATION_MCP_ADMIN=false
FOUNDATION_MCP_NOTION=false
REST_PATH=/api/v1
FOUNDATION_TIME_ZONE=Asia/Seoul
FOUNDATION_API_KEY=
FOUNDATION_PUBLIC_BASE_URL=http://127.0.0.1:8787
OAUTH_ENABLED=true
OAUTH_APPROVAL_SECRET=
OAUTH_ACCESS_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_SECONDS=2592000
NOTION_CLI=ntn
NOTION_DATA_SOURCE_ID=

# Host-native Foundation configuration (recommended on macOS)
LLM_PROVIDER=apple
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=3072

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INTERPRETATION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Docker Compose cloud profile cannot use Apple Foundation Models.
CLOUD_LLM_PROVIDER=openai

# Optional override after: npm run build:apple-model
APPLE_FOUNDATION_BRIDGE=
AI_TIMEOUT_MS=30000
