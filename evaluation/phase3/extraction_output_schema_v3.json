{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quote": {
                "type": "string"
              },
              "occurrence": {
                "type": "integer",
                "description": "ZERO-based: 0 means the first occurrence, including when it is the only occurrence. Never use ordinal 1 for the first."
              }
            },
            "required": [
              "quote",
              "occurrence"
            ],
            "description": "Choose exact ORIGINAL evidence before drafting this Claim. Keep the evidence-span language; use the whole necessary supporting span, with literal quote and occurrence."
          },
          "lang": {
            "type": "string",
            "enum": [
              "ko",
              "en"
            ],
            "description": "Language of the selected supporting proposition, not the overall document or other Claims. An English proposition with a Korean antecedent remains English; name the antecedent explicitly in its text."
          },
          "speaker": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "external",
              "unknown"
            ]
          },
          "speaker_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "Fact",
              "View",
              "Intent",
              "Rule"
            ]
          },
          "tkind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "habit",
                  "state",
                  "event",
                  "observation",
                  "decision",
                  "report_past"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "applies_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "applies_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "standing": {
            "type": "boolean"
          },
          "index_fields": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stance": {
                    "type": "string"
                  },
                  "holder": {
                    "type": "string"
                  },
                  "certainty": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string"
                  }
                },
                "required": [
                  "stance",
                  "holder",
                  "certainty",
                  "condition"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "revision_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "description": "Now express ONE independent proposition. Bind speaker, every required participant or affected target, modality and original-utterance relative time inside this text. If an affected target is unknown, use an explicitly unidentified generic target noun phrase rather than leaving its slot implicit; never invent a device/person category. Each conjecture and separate checking-status Claim independently names that target. Name cross-language antecedents directly. Do not replace a verification target with document/grammar commentary."
          },
          "basis": {
            "type": "string",
            "enum": [
              "verbatim",
              "paraphrase",
              "inferred",
              "observed",
              "restated",
              "operational"
            ],
            "description": "Choose after writing text: verbatim only for unchanged exact ORIGINAL substring; otherwise use source-supported paraphrase. Rendering perspective or resolving an antecedent changes the text."
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "surface": {
                  "type": "string"
                },
                "occurrence": {
                  "type": "integer",
                  "enum": [
                    0
                  ],
                  "description": "Index the first exact occurrence in the finished Claim text, zero-based. Optional indexing may be empty."
                }
              },
              "required": [
                "surface",
                "occurrence"
              ]
            },
            "description": "Optional indexing only: prefer []. Every surface must be an exact substring of this already-written Claim text with a valid occurrence. Do not copy technical nouns merely because they occur elsewhere in the source."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "parent": {
                  "type": "integer"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "premise",
                    "restates",
                    "alternative",
                    "informed_by"
                  ]
                }
              },
              "required": [
                "parent",
                "kind"
              ]
            }
          }
        },
        "required": [
          "anchor",
          "lang",
          "speaker",
          "speaker_label",
          "category",
          "tkind",
          "applies_from",
          "applies_to",
          "standing",
          "index_fields",
          "revision_of",
          "text",
          "basis",
          "mentions",
          "dependencies"
        ]
      }
    },
    "empty_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "claims",
    "empty_reason"
  ]
}
